APP_NAME="Rishesh Shakya"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=risheshakya

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Portfolio ---
# Optional: seed an admin account (or run `php artisan portfolio:admin you@example.com`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# AI-assisted extraction from imported conversations (optional).
# Contact-form email to the owner (defaults to the profile email). Needs a real MAIL_MAILER.
CONTACT_NOTIFY=true
CONTACT_NOTIFY_EMAIL=

# Public "Ask about me" assistant. Off by default: every question costs API credit. Needs ANTHROPIC_API_KEY.
PORTFOLIO_ASSISTANT=false

# Leave AI_PROVIDER empty to use only the keyword scan and manual proposals.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Limits
PORTFOLIO_IMPORT_MAX_KB=51200
PORTFOLIO_IMAGE_MAX_KB=4096
PORTFOLIO_RESUME_MAX_KB=10240
